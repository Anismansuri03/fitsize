{
  "name": "fitsize",
  "version": "1.0.0",
  "private": true,
  "description": "Free, open-source PDF & image toolkit that runs entirely in your browser. Compress, merge, split, edit, sign and convert PDFs and pictures \u2014 nothing is ever uploaded.",
  "keywords": [
    "pdf",
    "pdf-editor",
    "pdf-tools",
    "compress-pdf",
    "merge-pdf",
    "split-pdf",
    "image-compression",
    "webassembly",
    "wasm",
    "client-side",
    "privacy",
    "offline-first",
    "ilovepdf-alternative",
    "smallpdf-alternative",
    "sejda-alternative",
    "astro",
    "react",
    "no-upload",
    "open-source"
  ],
  "homepage": "https://github.com/Anismansuri03/fitsize#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anismansuri03/fitsize.git"
  },
  "bugs": {
    "url": "https://github.com/Anismansuri03/fitsize/issues"
  },
  "author": "Anis Mansuri",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare-assets": "node scripts/copy-assets.mjs",
    "dev": "npm run prepare-assets && astro dev",
    "build": "npm run prepare-assets && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@jspawn/ghostscript-wasm": "^0.0.2",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "astro": "^7.3.3",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
