---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';
import { tools } from '../data/tools';
import { CATEGORIES } from '../data/tools';
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
  h1?: string;
  lede?: string;
  metaTitle?: string;
  metaDescription?: string;
  /** Links to sibling landing pages (other sizes). */
  sizeLinks?: { href: string; label: string }[];
  sizeLinksHeading?: string;
  /** Full-width layout for app-like tools (the PDF editor). */
  wide?: boolean;
}
const { tool, sizeLinks, sizeLinksHeading, wide } = Astro.props;
const path = Astro.url.pathname;
const h1 = Astro.props.h1 ?? tool.h1;
const lede = Astro.props.lede ?? tool.lede;
const metaTitle = Astro.props.metaTitle ?? tool.metaTitle;
const metaDescription = Astro.props.metaDescription ?? tool.metaDescription;
const sameCategory = tools.filter((t) => t.slug !== tool.slug && t.category === tool.category);
const categoryLabel = CATEGORIES.find((c) => c.id === tool.category)?.label ?? 'tools';
// Small categories (Protect has only 2 tools) borrow from the rest of the list rather than mislabel them.
const usesFallback = sameCategory.length < 3;
const related = usesFallback
  ? [...sameCategory, ...tools.filter((t) => t.slug !== tool.slug && t.category !== tool.category)].slice(0, 6)
  : sameCategory.slice(0, 6);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${SITE.name}: ${tool.name}`,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: metaDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: tool.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'All tools', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: tool.name, item: new URL(path, Astro.site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: h1,
    description: lede,
    totalTime: 'PT1M',
    step: tool.steps.map((s) => ({ '@type': 'HowToStep', name: s.title, text: s.text })),
  },
];
---
<Base title={metaTitle} description={metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="tool-col">
    <div class={wide ? 'page-head page-head--compact' : 'page-head'}>
      <p class="crumbs"><a href="/">All tools</a> / {tool.name}</p>
      <h1>{h1}</h1>
      <p>{lede}</p>
    </div>
  </div>

  <div class={wide ? 'editor-wrap' : 'tool-col'}>
    <slot />
    <noscript>
      <div class="panel"><p>This tool needs JavaScript. Please turn it on in your browser and reload the page.</p></div>
    </noscript>
  </div>

  <section class="section prose-narrow">
    <h2>How it works</h2>
    <ol class="steps">
      {tool.steps.map((s) => (
        <li>
          <div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  {sizeLinks && (
    <section class="section prose-narrow">
      <h2>{sizeLinksHeading ?? 'Other sizes'}</h2>
      <div class="related">
        {sizeLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </section>
  )}

  <section class="section prose-narrow faq">
    <h2>Questions</h2>
    {tool.faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="section prose-narrow">
    <h2>{usesFallback ? 'More tools' : `More ${categoryLabel.toLowerCase()} tools`}</h2>
    <div class="related">
      {related.map((t) => (
        <a href={`/${t.slug}/`}><Icon name={t.icon} size={18} /> {t.name}</a>
      ))}
    </div>
  </section>
</Base>
